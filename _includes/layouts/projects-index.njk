---
layout: layouts/base.njk
---
<section class="section">
	<div class="section__inner section__inner--wide">
		<p class="section-label">Портфолио</p>
		<h1 class="section-title">Проекты</h1>

		<div class="projects-grid">
			{%- for project in collections.projects %}
			<article class="project-card{% if project.data.featured %} project-card--featured{% endif %}">
				<div class="project-card__header">
					<div class="project-card__icon">
						<i data-lucide="{{ project.data.icon or 'folder' }}" width="22" height="22"></i>
					</div>
					<div class="project-card__links">
						{%- if project.data.url %}
						<a href="{{ project.data.url }}" class="project-link" target="_blank" rel="noopener noreferrer" aria-label="Сайт проекта">
							<i data-lucide="external-link" width="14" height="14"></i>
						</a>
						{%- endif %}
						<a href="{{ project.url }}" class="project-link" aria-label="Подробнее">
							<i data-lucide="arrow-right" width="14" height="14"></i>
						</a>
					</div>
				</div>

				<div class="project-card__body">
					<div>
						<h2 class="project-card__title">{{ project.data.title }}</h2>
						{%- if project.data.role %}
						<p class="project-card__role">{{ project.data.role }}</p>
						{%- endif %}
					</div>
					<p class="project-card__desc">{{ project.templateContent | stripHtml | truncate(160) }}</p>
					{%- if project.data.tags_list %}
					<div class="project-card__tags">
						{%- for tag in project.data.tags_list %}
						<span class="tag">{{ tag }}</span>
						{%- endfor %}
					</div>
					{%- endif %}
				</div>

				{%- if project.data.featured and project.data.image %}
				<div class="project-card__visual">
					<img src="{{ project.data.image }}" alt="{{ project.data.title }}" loading="lazy" />
				</div>
				{%- endif %}
			</article>
			{%- endfor %}
		</div>
	</div>
</section>
