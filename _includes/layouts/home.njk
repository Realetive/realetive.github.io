---
layout: layouts/base.njk
---

{# ── HERO ── #}
<section class="hero" aria-label="Представление">
	<div class="hero__bg" aria-hidden="true"></div>
	<div class="hero__overlay" aria-hidden="true"></div>
	<div class="hero__content">
		<p class="hero__eyebrow">{{ person.eyebrow }}</p>
		<h1 class="hero__title">{{ person.title }}<br><em>{{ person.titleAccent }}</em></h1>
		<p class="hero__lead">{{ person.lead }}</p>
		<div class="hero__stats">
			{%- for stat in person.stats %}
			<div>
				<div class="hero__stat-value">{{ stat.value }}</div>
				<div class="hero__stat-label">{{ stat.label }}</div>
			</div>
			{%- endfor %}
		</div>
		<div class="hero__actions">
			<a href="/projects/" class="btn-primary">
				<i data-lucide="layers" width="16" height="16"></i>
				Посмотреть проекты
			</a>
			<a href="/contacts/" class="btn-ghost">
				Связаться
			</a>
		</div>
	</div>
</section>

{# ── CAREER ── #}
<section class="section" id="career">
	<div class="section__inner">
		<p class="section-label">Опыт</p>
		<h2 class="section-title">Карьера</h2>
		<ul class="career" aria-label="История работы">
			{%- for item in career %}
			<li class="career__item">
				<div class="career__period">{{ item.period }}</div>
				<div class="career__body">
					<div class="career__company">{{ item.company }}</div>
					<div class="career__role">{{ item.role }}</div>
					<ul class="career__points">
						{%- for point in item.points %}
						<li>{{ point }}</li>
						{%- endfor %}
					</ul>
					<div class="career__tags">
						{%- for tag in item.tags %}
						<span class="tag">{{ tag }}</span>
						{%- endfor %}
					</div>
				</div>
			</li>
			{%- endfor %}
		</ul>
	</div>
</section>

{# ── SKILLS ── #}
<section class="section section--no-top">
	<div class="section__inner">
		<p class="section-label">Компетенции</p>
		<h2 class="section-title">Что умею</h2>
		<div class="skills-grid">
			{%- for skill in skills %}
			<div class="skill-card">
				<div class="skill-card__icon">
					<i data-lucide="{{ skill.icon }}" width="22" height="22"></i>
				</div>
				<h3 class="skill-card__title">{{ skill.title }}</h3>
				<p class="skill-card__desc">{{ skill.desc }}</p>
			</div>
			{%- endfor %}
		</div>
	</div>
</section>

{{ content | safe }}
